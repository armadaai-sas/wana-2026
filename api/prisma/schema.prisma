generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  guest
  host
  admin
}

enum PropertyStatus {
  draft
  published
  unavailable
  maintenance
}

enum MediaType {
  image
  video
}

enum MediaStatus {
  pending
  approved
  rejected
}

enum BookingStatus {
  draft
  pending_payment
  confirmed
  checked_in
  completed
  cancelled
}

enum PaymentProvider {
  bold
  stripe
}

enum PaymentStatus {
  pending
  processing
  succeeded
  failed
  refunded
}

enum AvailabilitySource {
  booking
  manual
  maintenance
}

enum InvoiceStatus {
  pending
  issued
  failed
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String?
  passwordHash String?  @map("password_hash")
  role         UserRole @default(guest)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  properties Property[] @relation("HostProperties")
  bookings   Booking[]  @relation("GuestBookings")

  @@map("users")
}

model Property {
  id            String         @id @default(uuid())
  slug          String         @unique
  title         String
  description   String?
  pricePerNight Decimal        @map("price_per_night") @db.Decimal(10, 2)
  maxGuests     Int            @default(2) @map("max_guests")
  status        PropertyStatus @default(draft)
  city          String?
  country       String         @default("CO")
  latitude      Decimal?       @db.Decimal(10, 7)
  longitude     Decimal?       @db.Decimal(10, 7)
  amenities     Json           @default("[]")
  hostId        String         @map("host_id")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  host               User                @relation("HostProperties", fields: [hostId], references: [id])
  media              PropertyMedia[]
  availabilityBlocks AvailabilityBlock[]
  bookings           Booking[]
  reviews            Review[]

  @@index([status, city])
  @@map("properties")
}

model PropertyMedia {
  id           String      @id @default(uuid())
  propertyId   String      @map("property_id")
  type         MediaType   @default(image)
  url          String
  thumbnailUrl String?     @map("thumbnail_url")
  sortOrder    Int         @default(0) @map("sort_order")
  status       MediaStatus @default(pending)
  contentType  String?     @map("content_type")
  sizeBytes    Int?        @map("size_bytes")
  createdAt    DateTime    @default(now()) @map("created_at")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, sortOrder])
  @@map("property_media")
}

model AvailabilityBlock {
  id         String             @id @default(uuid())
  propertyId String             @map("property_id")
  startDate  DateTime           @map("start_date") @db.Date
  endDate    DateTime           @map("end_date") @db.Date
  source     AvailabilitySource @default(booking)
  bookingId  String?            @map("booking_id")
  createdAt  DateTime           @default(now()) @map("created_at")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  booking  Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([propertyId, startDate, endDate])
  @@map("availability_blocks")
}

model Booking {
  id             String        @id @default(uuid())
  propertyId     String        @map("property_id")
  guestId        String        @map("guest_id")
  checkIn        DateTime      @map("check_in") @db.Date
  checkOut       DateTime      @map("check_out") @db.Date
  guests         Int           @default(1)
  status         BookingStatus @default(draft)
  feesBreakdown  Json?         @map("fees_breakdown")
  idempotencyKey String?       @unique @map("idempotency_key")
  guestEmail     String?       @map("guest_email")
  guestName      String?       @map("guest_name")
  invoiceId      String?       @map("invoice_id")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  property           Property            @relation(fields: [propertyId], references: [id])
  guest              User                @relation("GuestBookings", fields: [guestId], references: [id])
  payments           Payment[]
  events             BookingEvent[]
  availabilityBlocks AvailabilityBlock[]
  pendingInvoices    PendingInvoice[]

  @@index([propertyId, status])
  @@index([guestId])
  @@map("bookings")
}

model BookingEvent {
  id        String        @id @default(uuid())
  bookingId String        @map("booking_id")
  fromStatus BookingStatus? @map("from_status")
  toStatus  BookingStatus @map("to_status")
  metadata  Json?
  createdAt DateTime      @default(now()) @map("created_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt])
  @@map("booking_events")
}

model Payment {
  id             String          @id @default(uuid())
  bookingId      String          @map("booking_id")
  provider       PaymentProvider
  amount         Decimal         @db.Decimal(10, 2)
  currency       String          @default("COP")
  status         PaymentStatus   @default(pending)
  externalId     String?         @map("external_id")
  idempotencyKey String          @unique @map("idempotency_key")
  metadata       Json?
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  booking  Booking          @relation(fields: [bookingId], references: [id])
  attempts PaymentAttempt[]

  @@index([bookingId])
  @@map("payments")
}

model PaymentAttempt {
  id        String        @id @default(uuid())
  paymentId String        @map("payment_id")
  status    PaymentStatus
  error     String?
  raw       Json?
  createdAt DateTime      @default(now()) @map("created_at")

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId, createdAt])
  @@map("payment_attempts")
}

model Review {
  id         String   @id @default(uuid())
  propertyId String   @map("property_id")
  rating     Int
  comment    String?
  isVisible  Boolean  @default(true) @map("is_visible")
  createdAt  DateTime @default(now()) @map("created_at")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, isVisible])
  @@map("reviews")
}

model PendingInvoice {
  id              String        @id @default(uuid())
  bookingId       String        @map("booking_id")
  transactionId   String?       @map("transaction_id")
  invoiceData     Json          @map("invoice_data")
  guestEmail      String?       @map("guest_email")
  guestName       String?       @map("guest_name")
  status          InvoiceStatus @default(pending)
  alegraError     String?       @map("alegra_error")
  alegraInvoiceId String?       @map("alegra_invoice_id")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([bookingId])
  @@map("pending_invoices")
}
