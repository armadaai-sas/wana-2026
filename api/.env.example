# Waná API — local development
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

DATABASE_URL=postgresql://wana:wana_dev_password@localhost:5432/wana?schema=public
REDIS_URL=redis://localhost:6379

MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=wana_minio
MINIO_SECRET_KEY=wana_minio_password
MINIO_BUCKET=wana-media
MINIO_USE_SSL=false

JWT_SECRET=wana_dev_jwt_secret_change_in_production
CORS_ORIGIN=http://localhost:3000

# Unpaid booking hold TTL (minutes) + job interval (ms)
BOOKING_PENDING_TTL_MINUTES=30
BOOKING_EXPIRY_JOB_INTERVAL_MS=300000

# OTA calendar import (Fase 1 — iCal Airbnb / Booking.com)
# ICAL_SYNC_ENABLED=1
# ICAL_IMPORT_PROPERTY_SLUG=glamping-wana
# ICAL_IMPORT_AIRBNB_URL=
# ICAL_IMPORT_BOOKING_URL=
# ICAL_SYNC_JOB_INTERVAL_MS=600000

# Payments — mock mode for local dev without keys
PAYMENTS_MODE=mock

# Bold (Colombia)
BOLD_API_KEY=
BOLD_WEBHOOK_SECRET=

# Stripe (internacional)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_COP_USD_RATE=4000

# MinIO / S3 media
MINIO_PUBLIC_URL=http://localhost:9000/wana-media
MEDIA_AUTO_APPROVE=true

# Marketing (Fase 4)
PUBLIC_SITE_URL=http://localhost:3000
RESEND_API_KEY=
RESEND_FROM=Waná <reservas@wana.co>
META_PIXEL_ID=
META_ACCESS_TOKEN=

# Alegra (Fase 6B — facturación Colombia)
ALEGRA_EMAIL=
ALEGRA_API_TOKEN=
