{
  "name": "Waná 2026 (web + api + postgres)",
  "user": "ubuntu",
  "install": "bash .cursor/install.sh",
  "start": "bash .cursor/start.sh",
  "terminals": [
    {
      "name": "api",
      "command": "cd api && npm run dev"
    },
    {
      "name": "web",
      "command": "npm run dev"
    }
  ],
  "ports": [
    { "name": "web", "port": 3000 },
    { "name": "api", "port": 4000 }
  ]
}
