{
  "name": "wana-2026",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "docker:infra": "docker compose up -d postgres redis minio minio-init",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:prod:build": "docker compose -f docker-compose.prod.yml --env-file .env.production build",
    "docker:prod:up": "docker compose -f docker-compose.prod.yml --env-file .env.production up -d",
    "docker:prod:down": "docker compose -f docker-compose.prod.yml --env-file .env.production down",
    "go-live:setup": "./deploy/scripts/go-live-setup.sh",
    "go-live:validate": "./deploy/scripts/validate-env.sh",
    "go-live:validate:staging": "STAGING=1 ./deploy/scripts/validate-env.sh",
    "go-live:deploy": "./deploy/scripts/deploy-prod.sh",
    "go-live:remote": "./deploy/scripts/remote-deploy.sh",
    "go-live:staging": "./deploy/scripts/deploy-staging.sh",
    "go-live:verify": "./deploy/scripts/verify-health.sh",
    "api:dev": "cd api && npm run dev",
    "api:migrate": "cd api && npx prisma migrate deploy",
    "api:seed": "cd api && npx prisma db seed"
  },
  "dependencies": {
    "@google-cloud/vision": "^5.3.6",
    "@hookform/resolvers": "^5.4.0",
    "@netlify/plugin-nextjs": "^5.15.11",
    "@opentelemetry/api": "^1.9.1",
    "@supabase/auth-helpers-nextjs": "^0.7.1",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.2",
    "@stripe/react-stripe-js": "^3.7.0",
    "@stripe/stripe-js": "^5.10.0",
    "@upstash/ratelimit": "^0.1.0",
    "@upstash/redis": "^1.20.0",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "framer-motion": "^12.40.0",
    "next": "^16.2.6",
    "react": "^19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.76.1",
    "react-hot-toast": "^2.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "25.9.1",
    "@types/react": "19.2.15",
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.0",
    "typescript": "6.0.3"
  }
