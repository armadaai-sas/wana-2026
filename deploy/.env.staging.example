# Waná — Pre-live staging (sin keys)
# Copia a .env.staging en el servidor

POSTGRES_USER=wana
POSTGRES_PASSWORD=change_me
POSTGRES_DB=wana

NEXT_PUBLIC_SITE_URL=http://localhost
NEXT_PUBLIC_API_URL=http://localhost
PUBLIC_SITE_URL=http://localhost
CORS_ORIGIN=http://localhost,https://eleveri.app,https://www.eleveri.app

NODE_ENV=production
PORT=4000
HOST=0.0.0.0
JWT_SECRET=change_me_jwt_min_32_chars
PAYMENTS_MODE=mock
NEXT_PUBLIC_PAYMENTS_MODE=mock

# Smoke tests automatizados (mock-booking-smoke.sh) — bypass Turnstile
SMOKE_AUTH_SECRET=change_me_smoke_secret_min_16_chars

MINIO_ACCESS_KEY=wana_minio_prod
MINIO_SECRET_KEY=change_me_minio
MINIO_BUCKET=wana-media
MINIO_PUBLIC_URL=http://localhost/wana-media
MEDIA_AUTO_APPROVE=true

BOLD_API_KEY=
BOLD_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_COP_USD_RATE=4000

# --- Cloudflare Turnstile ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_site_key_here
TURNSTILE_SECRET_KEY=your_secret_key_here
# Hostnames en Cloudflare widget: eleveri.app, www.eleveri.app, localhost
# Bypass emergencia: TURNSTILE_DISABLED=1 y NEXT_PUBLIC_TURNSTILE_DISABLED=1

ALEGRA_EMAIL=
ALEGRA_API_TOKEN=

RESEND_API_KEY=
RESEND_FROM="Waná <reservas@wana.co>"
META_PIXEL_ID=
META_ACCESS_TOKEN=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=

SENTRY_DSN=

# --- OTA calendar sync (Fase 1: import iCal) ---
# Activar solo cuando tengas las URLs de export (no commitear URLs reales).
# ICAL_SYNC_ENABLED=1
# ICAL_IMPORT_PROPERTY_SLUG=glamping-wana
# ICAL_IMPORT_AIRBNB_URL=
# ICAL_IMPORT_BOOKING_URL=
# ICAL_SYNC_JOB_INTERVAL_MS=600000
